{
  // taylor.fyi/map-for-google-photos: the extension's page and privacy policy. It has no address of its
  // own: the taylor-fyi router serves it through a PHOTOSMAP service binding and strips the prefix, which
  // is why every URL in the site is relative. taylor.fyi/map redirects here (also the router).
  "name": "map-for-google-photos",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" }
}
